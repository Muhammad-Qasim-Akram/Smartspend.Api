###
@baseUrl = http://localhost:5111

###############################
# AUTH (public, no token)
###############################

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "FirstName": "Qasim",
    "LastName": "Akram",
    "Email": "test@gmail.com",
    "Password": "justacheck"
}

### Login (named so other requests can reuse the token)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "Email": "test@gmail.com",
    "Password": "justacheck"
}

###############################
# TOKEN (run Login first)
###############################
@token = {{login.response.body.token}}

###############################
# CATEGORIES
###############################

### Get all categories (defaults + yours)
GET {{baseUrl}}/api/categories
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1laWQiOiIxIiwiZW1haWwiOiJtcWFrcmFtMjAwNUBnbWFpbC5jb20iLCJuYmYiOjE3OTI2MzU1NTcsImV4cCI6MTc5MzI0MDM1NywiaWF0IjoxNzkyNjM1NTU3LCJpc3MiOiJTbWFydFNwZW5kIiwiYXVkIjoiU21hcnRTcGVuZFVzZXJzIn0.o6ZC2MdPVZ-d6Sub9ARLmFXnxHHEUMfIzv4RTp9e5Oo
### Get category by id
GET {{baseUrl}}/api/categories/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1laWQiOiIxIiwiZW1haWwiOiJtcWFrcmFtMjAwNUBnbWFpbC5jb20iLCJuYmYiOjE3OTI2MzU0NjEsImV4cCI6MTc5MzI0MDI2MSwiaWF0IjoxNzkyNjM1NDYxLCJpc3MiOiJTbWFydFNwZW5kIiwiYXVkIjoiU21hcnRTcGVuZFVzZXJzIn0.8xfnRF9yUCB41KS5yPtstZlVVjFKowgDKkWdDOaWJHo
### Create custom category
POST {{baseUrl}}/api/categories
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1laWQiOiIxIiwiZW1haWwiOiJtcWFrcmFtMjAwNUBnbWFpbC5jb20iLCJuYmYiOjE3OTI2MzU1NTcsImV4cCI6MTc5MzI0MDM1NywiaWF0IjoxNzkyNjM1NTU3LCJpc3MiOiJTbWFydFNwZW5kIiwiYXVkIjoiU21hcnRTcGVuZFVzZXJzIn0.o6ZC2MdPVZ-d6Sub9ARLmFXnxHHEUMfIzv4RTp9e5Oo
Content-Type: application/json

{
    "Name": "Gaming"
}

### Update category (only your own custom ones)
PUT {{baseUrl}}/api/categories/7
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1laWQiOiIxIiwiZW1haWwiOiJtcWFrcmFtMjAwNUBnbWFpbC5jb20iLCJuYmYiOjE3OTI2MzU1NTcsImV4cCI6MTc5MzI0MDM1NywiaWF0IjoxNzkyNjM1NTU3LCJpc3MiOiJTbWFydFNwZW5kIiwiYXVkIjoiU21hcnRTcGVuZFVzZXJzIn0.o6ZC2MdPVZ-d6Sub9ARLmFXnxHHEUMfIzv4RTp9e5Oo
Content-Type: application/json

{
    "Name": "Games"
}

### Delete category
DELETE {{baseUrl}}/api/categories/11
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1laWQiOiIxIiwiZW1haWwiOiJtcWFrcmFtMjAwNUBnbWFpbC5jb20iLCJuYmYiOjE3OTI2MzU1NTcsImV4cCI6MTc5MzI0MDM1NywiaWF0IjoxNzkyNjM1NTU3LCJpc3MiOiJTbWFydFNwZW5kIiwiYXVkIjoiU21hcnRTcGVuZFVzZXJzIn0.o6ZC2MdPVZ-d6Sub9ARLmFXnxHHEUMfIzv4RTp9e5Oo

###############################
# EXPENSES
###############################

### Get all expenses
GET {{baseUrl}}/api/expense
Authorization: Bearer {{token}}

### Get expense by id
GET {{baseUrl}}/api/expense/1
Authorization: Bearer {{token}}

### Create expense
POST {{baseUrl}}/api/expenses
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1laWQiOiIxIiwiZW1haWwiOiJtcWFrcmFtMjAwNUBnbWFpbC5jb20iLCJuYmYiOjE3OTI2MzU1NTcsImV4cCI6MTc5MzI0MDM1NywiaWF0IjoxNzkyNjM1NTU3LCJpc3MiOiJTbWFydFNwZW5kIiwiYXVkIjoiU21hcnRTcGVuZFVzZXJzIn0.o6ZC2MdPVZ-d6Sub9ARLmFXnxHHEUMfIzv4RTp9e5Oo
Content-Type: application/json

{
    "Amount": 8000,
    "Description": "Gaming",
    "Date": "2026-10-22",
    "CategoryId": 11
}

### Update expense
PUT {{baseUrl}}/api/expense/9
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "Amount": 750,
    "Description": "Dinner",
    "Date": "2026-10-22",
    "CategoryId": 1
}

### Delete expense
DELETE {{baseUrl}}/api/expense/1
Authorization: Bearer {{token}}

###############################
# BUDGETS
###############################

### Get all budgets
GET {{baseUrl}}/api/budgets
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1laWQiOiIxIiwiZW1haWwiOiJtcWFrcmFtMjAwNUBnbWFpbC5jb20iLCJuYmYiOjE3OTI2MzU1NTcsImV4cCI6MTc5MzI0MDM1NywiaWF0IjoxNzkyNjM1NTU3LCJpc3MiOiJTbWFydFNwZW5kIiwiYXVkIjoiU21hcnRTcGVuZFVzZXJzIn0.o6ZC2MdPVZ-d6Sub9ARLmFXnxHHEUMfIzv4RTp9e5Oo

### Get budget by id
GET {{baseUrl}}/api/budgets/1
Authorization: Bearer {{token}}

### Create budget
POST {{baseUrl}}/api/budgets
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1laWQiOiIxIiwiZW1haWwiOiJtcWFrcmFtMjAwNUBnbWFpbC5jb20iLCJuYmYiOjE3OTI2MzU1NTcsImV4cCI6MTc5MzI0MDM1NywiaWF0IjoxNzkyNjM1NTU3LCJpc3MiOiJTbWFydFNwZW5kIiwiYXVkIjoiU21hcnRTcGVuZFVzZXJzIn0.o6ZC2MdPVZ-d6Sub9ARLmFXnxHHEUMfIzv4RTp9e5Oo
Content-Type: application/json

{
    "Amount": 6000,
    "CategoryId": 999,
    "StartDate": "2026-10-01",
    "EndDate": "2026-10-31"
}

### Update budget
PUT {{baseUrl}}/api/budgets/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "Amount": 6000,
    "CategoryId": 1,
    "StartDate": "2026-10-01",
    "EndDate": "2026-10-31"
}

### Delete budget
DELETE {{baseUrl}}/api/budgets/1
Authorization: Bearer {{token}}

