{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
   "ConnectionStrings": {
    "SmartSpendDb": "Set_in_user_secrets"
  },
  "JwtSettings": {
    "SecretKey": "Set_in_user_secrets",
    "Issuer": "SmartSpend",
    "Audience": "SmartSpendUsers",
    "ExpiryDays": 7
}
}
